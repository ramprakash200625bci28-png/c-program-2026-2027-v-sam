#include <stdlib.h>
#include <string.h>

char* mergeAlternately(char* word1, char* word2) {
    int len1 = strlen(word1);
    int len2 = strlen(word2);
    
    // Allocate memory for the merged string (+1 for the null terminator)
    char* result = (char*)malloc((len1 + len2 + 1) * sizeof(char));
    
    int i = 0; // Pointer for word1
    int j = 0; // Pointer for word2
    int k = 0; // Pointer for result string
    
    // Alternately append characters until one string finishes
    while (i < len1 && j < len2) {
        result[k++] = word1[i++];
        result[k++] = word2[j++];
    }
    
    // Append the remainder of word1 if it is longer
    while (i < len1) {
        result[k++] = word1[i++];
    }
    
    // Append the remainder of word2 if it is longer
    while (j < len2) {
        result[k++] = word2[j++];
    }
    
    // Explicitly add the null terminator to finish the C-string
    result[k] = '\0';
    
    return result;
}


