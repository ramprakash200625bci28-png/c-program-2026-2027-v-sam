n(int a, int b) {
    return (a < b) ? a : b;
}

int countBinarySubstrings(char* s) {
    int len = strlen(s);
    if (len <= 1) return 0;
    
    int ans = 0;
    int prev_group_count = 0;
    int curr_group_count = 1;
    
    for (int i = 1; i < len; i++) {
        if (s[i] != s[i - 1]) {
            ans += min(prev_group_count, curr_group_count);
            prev_group_count = curr_group_count;
            curr_group_count = 1;
        } else {
            curr_group_count++;
        }
    }
    ans += min(prev_group_count, curr_group_count);
    
    return ans;
}
