void duplicateZeros(int* arr, int arrSize) {
    int possibleZeros = 0;
    int length_ = arrSize - 1;

    // First pass: Find the number of zeros to be duplicated that fit in the array
    for (int left = 0; left <= length_ - possibleZeros; left++) {
        if (arr[left] == 0) {
            // Edge case: This zero can't be duplicated because it's at the boundary
            if (left == length_ - possibleZeros) {
                arr[length_] = 0; // Copy it without duplication
                length_ -= 1;
                break;
            }
            possibleZeros++;
        }
    }

    // Second pass: Start from the end and copy elements backwards
    int last = length_ - possibleZeros;
    for (int i = last; i >= 0; i--) {
        if (arr[i] == 0) {
            arr[i + possibleZeros] = 0;
            possibleZeros--;
            arr[i + possibleZeros] = 0;
        } else {
            arr[i + possibleZeros] = arr[i];
        }
    }
}
