#include <string.h>
#include <stdbool.h>

int removePalindromeSub(char* s) {
    int len = strlen(s);
    if (len == 0) {
        return 0;
    }
    
    // Check if the entire string is a palindrome
    int left = 0;
    int right = len - 1;
    while (left < right) {
        if (s[left] != s[right]) {
            // Not a palindrome, can always be cleared in 2 steps
            return 2; 
        }
        left++;
        right--;
    }
    
    // It is a palindrome, can be cleared in 1 step
    return 1;
}
