
int* preorderTraversal(struct TreeNode* root, int* returnSize) {
    struct TreeNode* ptr = root;
    struct TreeNode* stack[100];
    int top = 0;
    int* result = malloc(100 * sizeof(int));
    *returnSize = 0;
    while (top != -1) {
        while (ptr != NULL) {
            result[*returnSize] = ptr->val;
            (*returnSize)++;
            if (ptr->right != NULL) {
                top++;
                stack[top] = ptr->right;
            }
            ptr = ptr->left;
        }
        ptr = stack[top];
        top--;
    }
    return result;
}
