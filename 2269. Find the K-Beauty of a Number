#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int divisorSubstrings(int num, int k) {
   
    char str[12];
    sprintf(str, "%d", num);
    
    int len = strlen(str);
    int k_beauty = 0;
    
    char *sub = (char *)malloc((k + 1) * sizeof(char));
    
   
    for (int i = 0; i <= len - k; i++) {
       
        strncpy(sub, str + i, k);
        
        int current_val = atoi(sub);
        
    
        if (current_val != 0 && num % current_val == 0) {
            k_beauty++;
        }
    }
    
    free(sub);
    
    return k_beauty;
}
